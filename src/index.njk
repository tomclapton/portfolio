<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ site.name }} — Photography &amp; Video</title>
  <meta name="description" content="Photography and video portfolio of {{ site.name }}.">

  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,380&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <a class="skip-link" href="#photography">Skip to content</a>

  <header class="site-header">
    <h1 class="font-display">{{ site.name }}</h1>
    <a class="header-email" href="mailto:{{ site.email }}">{{ site.email }}</a>
  </header>

  <main id="main">
    <section id="photography" aria-label="Photography">
      <div class="masonry">
        {% for p in photos %}
        <div class="masonry-item">
          <button class="gallery-item-btn" type="button" aria-label="Open photograph {{ loop.index }} of {{ photos.length }}">
            {% photo p.src, p.alt, "(min-width: 980px) 25vw, (min-width: 620px) 50vw, 100vw", [480, 800, 1280] %}
          </button>
          <template class="lightbox-source">
            {% photo p.src, p.alt, "90vw", [800, 1400, 2000] %}
          </template>
        </div>
        {% endfor %}
      </div>
    </section>

    <section id="video" aria-label="Video">
      <div class="video-list">
        {% for v in videos %}
        <div class="video-frame">
          <video controls preload="metadata" playsinline>
            <source src="{{ v.src }}" type="{{ v.type }}">
            Your browser does not support embedded video.
          </video>
        </div>
        {% endfor %}
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <span>{{ site.name }}</span>
    <a href="mailto:{{ site.email }}">{{ site.email }}</a>
  </footer>

  <div id="lightbox" class="lightbox" role="dialog" aria-modal="true" aria-label="Photograph viewer" hidden>
    <div class="lightbox-stage">
      <div class="lightbox-img-wrap"></div>
      <button class="lightbox-close" aria-label="Close viewer">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 5l14 14M19 5L5 19"/></svg>
      </button>
      <button class="lightbox-prev" aria-label="Previous photograph">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15 5l-7 7 7 7"/></svg>
      </button>
      <button class="lightbox-next" aria-label="Next photograph">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 5l7 7-7 7"/></svg>
      </button>
    </div>
  </div>

  <script src="/js/lightbox.js" defer></script>
</body>
</html>
